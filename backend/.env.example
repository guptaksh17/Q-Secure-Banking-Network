# Copy to backend/.env and adjust. Every variable uses the QSB_ prefix.
# No cryptographic key material is ever configured here or persisted anywhere.

QSB_APP_NAME="Q-Secure Banking Network"
QSB_ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API (Vite dev server by default).
QSB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file relative to backend/. PostgreSQL example (optional, later):
# QSB_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/qsb
QSB_DATABASE_URL=sqlite:///./qsb.db

# --- QKD defaults (illustrative, NOT universal security bounds) ---
# Abort if estimated QBER exceeds this fraction. 0.11 is a commonly cited
# illustrative BB84 value; real thresholds depend on the security proof used.
QSB_QBER_THRESHOLD=0.11
# Fraction of sifted bits revealed (then discarded) to estimate QBER.
QSB_QBER_SAMPLE_FRACTION=0.25
# Default number of qubits Alice sends per session. 4096 is roughly the minimum that
# yields a 256-bit final key after sampling, reconciliation and privacy amplification.
QSB_DEFAULT_QUBITS=4096
# "numpy" = mathematically modelled measurement statistics (fast)
# "qiskit" = per-qubit circuits executed on Qiskit Aer (slower, circuit-simulated)
QSB_QUANTUM_BACKEND=numpy
# Optional fixed seed for reproducible experiments; leave empty for OS randomness.
QSB_RANDOM_SEED=
